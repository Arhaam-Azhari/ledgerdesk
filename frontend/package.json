{
  "name": "ledgerdesk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:reconciliation": "playwright test --config playwright.reconciliation.config.ts",
    "test:reports": "playwright test --config playwright.reports.config.ts",
    "test:equity": "playwright test --config playwright.equity.config.ts",
    "test:adjustments": "playwright test --config playwright.adjustments.config.ts",
    "test:accruals": "playwright test --config playwright.accruals.config.ts",
    "test:handoff": "playwright test --config playwright.handoff.config.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
