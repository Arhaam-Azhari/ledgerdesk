    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "test:persistent": "playwright test --config playwright.persistent.config.ts",
    "test:reviewer": "playwright test --config playwright.reviewer.config.ts",
    "test:cash": "playwright test --config playwright.cash.config.ts",
    "test:assets": "playwright test --config playwright.assets.config.ts",
    "test:prepaid": "playwright test --config playwright.prepaid.config.ts",
    "test:opening": "playwright test --config playwright.opening.config.ts",
